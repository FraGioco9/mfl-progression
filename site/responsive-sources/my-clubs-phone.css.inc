@media (max-width: 640px) {
  .myClubsGrid {
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }

  .myClubCard {
    grid-template-columns: 104px minmax(0, 1fr);
    min-height: 128px;
  }

  .myClubLogoFrame {
    padding: 10px;
  }

  .myClubLogo {
    max-width: 82px;
    max-height: 90px;
  }

  .myClubCardBody {
    padding: 12px 13px;
  }

  .myClubName {
    font-size: 19px;
  }

  .myClubId {
    font-size: 12px;
  }

  .myClubMeta {
    font-size: 14px;
  }

  .myClubLoadingLogo {
    width: 72px;
    height: 72px;
  }

}
